# ── Локальная разработка ─────────────────────────────────────────
# Поставь true, чтобы зайти в оболочку БЕЗ Keycloak (под тестовым
# пользователем) и сразу посмотреть интерфейс.
VITE_AUTH_DISABLED=true

# ── Keycloak (реальный вход) ─────────────────────────────────────
VITE_KEYCLOAK_URL=https://auth.platform.ru
VITE_KEYCLOAK_REALM=platform
VITE_KEYCLOAK_CLIENT=web-desktop

# ── Адреса приложений (открываются в окнах) ──────────────────────
VITE_APP_SIZ_URL=https://siz.platform.ru

# Это НЕ секреты (обычный фронтенд-конфиг). Для прод-сборки скопируй
# нужные значения в .env.production и закоммить (см. README).
